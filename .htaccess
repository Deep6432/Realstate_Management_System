# Apache configuration for Hostinger Node.js deployment

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# HOSTINGER-SPECIFIC: Handle /public/* static files
# This ensures static files are served correctly on Hostinger

# Handle /public/* paths (PRIMARY - Hostinger requirement)
RewriteCond %{REQUEST_URI} ^/public/(.*)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^public/(.*)$ public/$1 [L]

# Fallback: Handle /static/* paths (for backward compatibility)
RewriteCond %{REQUEST_URI} ^/static/(.*)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^static/(.*)$ public/$1 [L]

# Fallback: Handle direct CSS files
RewriteCond %{REQUEST_URI} ^/css/(.*)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^css/(.*)$ public/css/$1 [L]

# Fallback: Handle direct JS files
RewriteCond %{REQUEST_URI} ^/js/(.*)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^js/(.*)$ public/js/$1 [L]

# Fallback: Handle direct images
RewriteCond %{REQUEST_URI} ^/images/(.*)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^images/(.*)$ public/images/$1 [L]

# Fallback: Handle favicon
RewriteCond %{REQUEST_URI} ^/favicon\.svg$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^favicon\.svg$ public/favicon.svg [L]

# Handle uploads
RewriteCond %{REQUEST_URI} ^/uploads/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads/(.*)$ uploads/$1 [L]

# Proxy all other requests to Node.js (if using reverse proxy)
# Uncomment if you're using Apache as reverse proxy to Node.js
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]

# If using Passenger for Node.js (Hostinger supports this)
<IfModule mod_passenger.c>
  PassengerAppRoot /home/your_username/public_html
  PassengerAppType node
  PassengerStartupFile server.js
  PassengerNodejs /usr/bin/node
  PassengerEnabled On
</IfModule>
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Prevent directory listing
Options -Indexes

# Enable compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static files
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
