<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Professional Real Estate Inventory Management System - Find and manage properties with ease">
    <title><%= typeof title !== 'undefined' ? title : 'Real Estate Inventory Management' %></title>
    <!-- CRITICAL: base href for Hostinger shared hosting -->
    <base href="/">
    <link rel="icon" type="image/svg+xml" href="/public/favicon.svg">
    <link rel="apple-touch-icon" href="/public/favicon.svg">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- HOSTINGER FIX: Use /public prefix (mandatory) -->
    <link rel="stylesheet" href="/public/css/style.css?v=4.1">
    <%- typeof extra_css !== 'undefined' ? extra_css : '' %>
</head>
<body>
    <nav class="navbar">
        <div class="container">
            <div class="nav-brand">
                <a href="/">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="display: inline-block; vertical-align: middle; margin-right: 8px;">
                        <path d="M3 12L5 10M5 10L12 3L19 10M5 10V20C5 20.5523 5.44772 21 6 21H9M19 10L21 12M19 10V20C19 20.5523 18.5523 21 18 21H15M9 21C9.55228 21 10 20.5523 10 20V16C10 15.4477 10.4477 15 11 15H13C13.5523 15 14 15.4477 14 16V20C14 20.5523 14.4477 21 15 21M9 21H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    Real Estate
                </a>
            </div>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/properties">Properties</a>
                <% if (user) { %>
                    <a href="/admin/dashboard">Dashboard</a>
                    <a href="/logout">Logout</a>
                <% } else { %>
                    <a href="/login">Admin Login</a>
                <% } %>
            </div>
        </div>
    </nav>

    <% if (typeof success !== 'undefined' && success.length > 0) { %>
        <div class="messages">
            <% success.forEach(function(message) { %>
                <div class="alert alert-success"><%= message %></div>
            <% }); %>
        </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error.length > 0) { %>
        <div class="messages">
            <% error.forEach(function(message) { %>
                <div class="alert alert-error"><%= message %></div>
            <% }); %>
        </div>
    <% } %>

    <main class="main-content">

