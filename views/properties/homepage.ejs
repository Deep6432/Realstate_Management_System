<%- include('../partials/header', { title: 'Home - Real Estate Inventory' }) %>

<div class="hero-section">
    <div class="container">
        <h1 class="hero-title">Find Your Perfect Property</h1>
        <p class="hero-subtitle">Search properties by city, type, or location</p>
        
        <div class="search-box-container">
            <form method="GET" action="/properties" class="search-form">
                <div class="search-input-group">
                    <input 
                        type="text" 
                        name="city" 
                        placeholder="Enter city, district, or village..." 
                        class="search-input"
                        autocomplete="off"
                    >
                    <button type="submit" class="search-btn">
                        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M9 17C13.4183 17 17 13.4183 17 9C17 4.58172 13.4183 1 9 1C4.58172 1 1 4.58172 1 9C1 13.4183 4.58172 17 9 17Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M19 19L14.65 14.65" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Search
                    </button>
                </div>
            </form>
        </div>

        <div class="global-search-container">
            <h3>Or search everything:</h3>
            <div class="global-search-wrapper">
                <input 
                    type="text" 
                    id="global-search" 
                    placeholder="Search by city, khasra number, address, type..."
                    class="global-search-input"
                    autocomplete="off"
                >
                <div id="search-results" class="search-results-dropdown"></div>
            </div>
        </div>
    </div>
</div>

<div class="features-section">
    <div class="container">
        <h2>Property Types</h2>
        <div class="property-types-grid">
            <% property_types.forEach(function([value, label]) { %>
                <a href="/properties?property_type=<%= encodeURIComponent(value) %>" class="property-type-card">
                    <div class="type-icon">
                        <% if (value === 'Home') { %>
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 12L5 10M5 10L12 3L19 10M5 10V20C5 20.5523 5.44772 21 6 21H9M19 10L21 12M19 10V20C19 20.5523 18.5523 21 18 21H15M9 21C9.55228 21 10 20.5523 10 20V16C10 15.4477 10.4477 15 11 15H13C13.5523 15 14 15.4477 14 16V20C14 20.5523 14.4477 21 15 21M9 21H15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        <% } else if (value === 'Flat / Apartment') { %>
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 21H21M4 21V7L12 3L20 7V21M7 21V13H11V21M15 21V13H19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        <% } else if (value === 'Plot') { %>
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 3H21V21H3V3Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                                <path d="M3 9H21M9 3V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        <% } else { %>
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 21H21M4 21V7L12 3L20 7V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        <% } %>
                    </div>
                    <h3><%= label %></h3>
                </a>
            <% }); %>
        </div>
    </div>
</div>

<script>
    const globalSearchInput = document.getElementById('global-search');
    const searchResults = document.getElementById('search-results');
    let searchTimeout;

    globalSearchInput.addEventListener('input', function() {
        const query = this.value.trim();
        clearTimeout(searchTimeout);
        
        if (query.length < 2) {
            searchResults.innerHTML = '';
            searchResults.style.display = 'none';
            return;
        }

        searchTimeout = setTimeout(() => {
            fetch(`/api/search?q=${encodeURIComponent(query)}`)
                .then(response => response.json())
                .then(data => {
                    displaySearchResults(data.properties);
                })
                .catch(error => console.error('Search error:', error));
        }, 300);
    });

    function displaySearchResults(properties) {
        if (properties.length === 0) {
            searchResults.innerHTML = '<div class="search-result-item">No properties found</div>';
            searchResults.style.display = 'block';
            return;
        }

        let html = '';
        properties.forEach(prop => {
            const imageHtml = prop.image_url 
                ? `<img src="${prop.image_url}" alt="${prop.property_type}" class="result-image">`
                : '<div class="result-image-placeholder">No Image</div>';
            
            html += `<a href="${prop.url}" class="search-result-item">${imageHtml}<div class="result-info"><h4>${prop.property_type}</h4><p>${prop.city} - ${prop.khasra_number}</p><p class="result-size">${prop.size} ${prop.size_unit}</p></div></a>`;
        });

        searchResults.innerHTML = html;
        searchResults.style.display = 'block';
    }

    document.addEventListener('click', function(e) {
        if (!globalSearchInput.contains(e.target) && !searchResults.contains(e.target)) {
            searchResults.style.display = 'none';
        }
    });
</script>

<%- include('../partials/footer') %>

